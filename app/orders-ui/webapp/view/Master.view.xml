<mvc:View
    controllerName="ordersui.controller.Master"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page
        title="Product Catalog"
        showHeader="true">

        <subHeader>
            <Bar>
                <contentMiddle>

                    <SearchField
                        width="100%"
                        placeholder="Search Categories..." />

                </contentMiddle>
            </Bar>
        </subHeader>

        <content>

            <List
                id="categoryList"
                items="{
                    path:'/Categories'
                }"
                mode="SingleSelectMaster"
                selectionChange=".onCategoryPress">

                <items>

                    <ObjectListItem
                        type="Active"
                        title="{categoryName}"
                        number="{productCount}"
                        numberUnit="Items" />

                </items>

            </List>

        </content>

    </Page>

</mvc:View>