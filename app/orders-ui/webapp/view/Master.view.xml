<mvc:View
    controllerName="ordersui.controller.Master"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page
        title="Product Catalog">

        <content>

            <!-- SEARCH -->

            <SearchField
                width="100%"
                placeholder="Search Categories..."
                liveChange=".onSearchCategory"
                class="sapUiSmallMarginBottom" />

            <!-- CATEGORY LIST -->

            <List
                id="categoryList"
                items="{
                    path:'/Categories',
                    templateShareable:false
                }"
                mode="None">

                <ObjectListItem
                    title="{categoryName}"
                    number="{productCount}"
                    numberUnit="Items"
                    type="Active"
                    press=".onCategoryPress" />

            </List>

        </content>

    </Page>

</mvc:View>