{
    "sap.app": {
        "id": "ordersui",
        "type": "application",
        "title": "Orders",
        "applicationVersion": {
            "version": "1.0.0"
        }
    },
    "sap.ui": {
        "technology": "UI5",
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },
    "sap.ui5": {
        "resources": {
            "css": [
                {
                    "uri": "css/style.css"
                }
            ]
        },
        "rootView": {
            "viewName": "ordersui.view.App",
            "type": "XML"
        },
        "dependencies": {
            "minUI5Version": "1.120.0",
            "libs": {
                "sap.m": {},
                "sap.f": {},
                "sap.ui.core": {},
                "sap.uxap": {},
                "sap.ui.layout": {}
            }
        },
        "models": {
            "": {
                "type": "sap.ui.model.odata.v4.ODataModel",
                "settings": {
                    "synchronizationMode": "None",
                    "operationMode": "Server",
                    "serviceUrl": "/odata/v4/orders/"
                }
            }
        },
        "routing": {
            "config": {
                "routerClass": "sap.f.routing.Router",
                "viewType": "XML",
                "viewPath": "ordersui.view",
                "controlId": "fcl",
                "async": true
            },
            "routes": [
                {
                    "pattern": "",
                    "name": "master",
                    "target": [
                        "master",
                        "home"
                    ]
                },
                {
                    "pattern": "cart",
                    "name": "cart",
                    "target": [
                        "master",
                        "home",
                        "cart"
                    ]
                },
                {
                    "pattern": "category/{category}",
                    "name": "categoryProducts",
                    "target": [
                        "categoryProducts"
                    ]
                },
                {
                    "pattern": "product/{productId}",
                    "name": "productDetail",
                    "target": [
                        "categoryProducts",
                        "productDetail"
                    ]
                },
                {
                    "pattern": "checkout",
                    "name": "checkout",
                    "target": "checkout"
                },
                {
                    "pattern": "review",
                    "name": "review",
                    "target": "review"
                },
                {
                    "pattern": "success",
                    "name": "success",
                    "target": "success"
                },
                {
                    "pattern": "orders",
                    "name": "orders",
                    "target": "orders"
                },
                {
                    "pattern": "orders/{orderId}",
                    "name": "orderDetail",
                    "target": [
                        "orders",
                        "orderDetail"
                    ]
                }
            ],
            "targets": {
                "master": {
                    "viewName": "Master",
                    "controlId": "fcl",
                    "controlAggregation": "beginColumnPages"
                },
                "home": {
                    "viewName": "Home",
                    "controlId": "fcl",
                    "controlAggregation": "midColumnPages"
                },
                "categoryProducts": {
                    "viewName": "CategoryProducts",
                    "controlId": "fcl",
                    "controlAggregation": "beginColumnPages"
                },
                "productDetail": {
                    "viewName": "ProductDetail",
                    "controlId": "fcl",
                    "controlAggregation": "midColumnPages"
                },
                "cart": {
                    "viewName": "Cart",
                    "controlId": "fcl",
                    "controlAggregation": "endColumnPages"
                },
                "checkout": {
                    "viewName": "Checkout",
                    "controlId": "app",
                    "controlAggregation": "pages"
                },
                "review": {
                    "viewName": "Review",
                    "controlId": "app",
                    "controlAggregation": "pages"
                },
                "success": {
                    "viewName": "OrderSuccess",
                    "controlId": "app",
                    "controlAggregation": "pages"
                },
                "orders": {
                    "viewName": "Orders",
                    "controlId": "fcl",
                    "controlAggregation": "beginColumnPages"
                },
                "orderDetail": {
                    "viewName": "OrderDetail",
                    "controlId": "fcl",
                    "controlAggregation": "midColumnPages"
                }
            }
        }
    }
}